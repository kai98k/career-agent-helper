# 複製成 .env 後填入自己的值；.env 不進版控
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# 新名稱；舊名 GOOGLE_GENAI_USE_VERTEXAI 仍可用，衝突時以本項為準
GOOGLE_GENAI_USE_ENTERPRISE=True

# 模型
GEMINI_MODEL=gemini-2.5-flash

# 應用
APP_ENV=local
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=10

# agent session 的儲存位置；留空＝只存記憶體，重開就沒了
SESSION_DB_URL=sqlite+aiosqlite:///./.sessions/sessions.db
# session 最後一次有動作之後保留幾小時，過了就刪
SESSION_TTL_HOURS=24

# Day 19：部署到 Agent Runtime
AGENT_RUNTIME_LOCATION=asia-east1
STAGING_BUCKET=gs://your-project-agent-staging
# deploy_agent.py 印出來的資源名稱
AGENT_ENGINE_NAME=
# deploy_cloud_run.py 印出來的服務網址（Day 20）
CLOUD_RUN_URL=

# Day 21：FastAPI 的 agent 端點要打哪裡。local＝本機 ADK + SQLite；runtime＝上面的 Agent Runtime
AGENT_BACKEND=local
